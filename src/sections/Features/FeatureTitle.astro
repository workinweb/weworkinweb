---
import { getLangFromUrl, useTranslations } from "../../i18n/translations";

const url = new URL(Astro.request.url);
const lang = getLangFromUrl(url);
const t = useTranslations(lang);
---

<div>
  <div
    class="absolute inset-0 bg-gradient-to-br from-slate-50 to-orange-50 dark:from-slate-900 dark:to-slate-800"
  >
    <div
      class="absolute inset-0 bg-grid-slate-200 [mask-image:linear-gradient(0deg,white,transparent)]"
      aria-hidden="true"
    >
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4">
    <div class="flex flex-col items-center pt-6 md:pt-8 pb-2 mb-10 text-center">
      <div class="inline-flex flex-col items-center gap-4 max-w-4xl">
        <h1
          class="text-3xl sm:text-4xl lg:text-5xl font-bold gradient-text text-balance text-center leading-tight"
        >
          {t("features.title")}
        </h1>
        <div
          class="h-1 w-24 bg-gradient-to-r from-orange-500 to-amber-500 rounded-full shrink-0"
          aria-hidden="true"
        >
        </div>
      </div>

      <p
        class="text-lg text-slate-600 dark:text-slate-300 mt-6 max-w-2xl mx-auto text-balance"
      >
        {t("features.subtitle")}
      </p>
    </div>
  </div>
</div>

<style>
  .bg-grid-slate-200 {
    background-image: linear-gradient(
        to right,
        rgba(172, 177, 183, 0.681) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        rgba(148, 156, 163, 0.312) 1px,
        transparent 1px
      );
    background-size: 48px 48px;
  }

  :global(.dark) .bg-grid-slate-200 {
    background-image: linear-gradient(
        to right,
        rgb(226 232 240 / 0.1) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgb(226 232 240 / 0.1) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .scrollbar-thin::-webkit-scrollbar {
    height: 6px;
  }

  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb {
    background: theme("colors.orange.500");
    border-radius: 9999px;
  }
</style>
